              "  pm.expect(Number.isNaN(Date.parse(profile.createdAt))).to.eql(false);",
              "  pm.expect(Number.isNaN(Date.parse(profile.updatedAt))).to.eql(false);",
              "});",
              "pm.test('Aucun secret dans la réponse', () => { pm.expect(profile).to.not.have.any.keys('password','access_token','refresh_token'); });",
              "pm.test('Même compte que sync dans le Runner', () => { const expected = pm.variables.get('profile_id'); if (expected) pm.expect(profile.id).to.eql(expected); });"
            ]
          }
        }
      ]
